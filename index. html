<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Nike Gift Card Giveaway</title>
<style>
*{box-sizing:border-box}
body{margin:0;font-family:Arial,Helvetica,sans-serif;background:linear-gradient(135deg,#111,#333);color:#fff;min-height:100vh}
.container{max-width:520px;margin:auto;padding:24px 16px}
.card{background:#fff;color:#111;border-radius:22px;overflow:hidden;box-shadow:0 15px 45px rgba(0,0,0,.35)}
.hero{padding:34px 24px;text-align:center;background:#f5f5f5}
.badge{display:inline-block;background:#111;color:#fff;padding:7px 12px;border-radius:20px;font-size:12px;font-weight:bold;letter-spacing:.5px}
h1{font-size:32px;margin:18px 0 10px}
.sub{color:#555;line-height:1.5;margin:0}
.gift{font-size:64px;margin:15px 0}
.content{padding:24px}
.steps{display:grid;gap:12px;margin:18px 0}
.step{display:flex;gap:12px;align-items:flex-start;background:#f7f7f7;padding:14px;border-radius:14px}
.num{width:30px;height:30px;border-radius:50%;background:#111;color:#fff;display:grid;place-items:center;font-weight:bold;flex:none}
.cta{display:block;width:100%;padding:17px;text-align:center;text-decoration:none;background:#111;color:#fff;border-radius:12px;font-weight:bold;font-size:17px;margin-top:20px}
.cta:hover{background:#333}
.note{font-size:12px;color:#666;line-height:1.5;text-align:center;margin-top:18px}
.footer{font-size:11px;color:#777;text-align:center;padding:0 24px 24px}
</style>
</head>
<body>
<div class="container">
  <div class="card">
    <section class="hero">
      <span class="badge">LIMITED PROMOTION</span>
      <div class="gift">🎁</div>
      <h1>Chance to Get a Nike Gift Card</h1>
      <p class="sub">Complete the required promotion steps to enter. Availability and eligibility may vary by location.</p>
    </section>

    <section class="content">
      <div class="steps">
        <div class="step"><div class="num">1</div><div><b>Start</b><br>Tap the button below to continue.</div></div>
        <div class="step"><div class="num">2</div><div><b>Complete</b><br>Follow the offer instructions and provide the requested information.</div></div>
        <div class="step"><div class="num">3</div><div><b>Entry</b><br>After successful completion, your entry is processed according to the offer terms.</div></div>
      </div>

      <!-- Replace https://app.trcefy.com/click?pid=2&offer_id=14565&sub2=u828931&sub5=s1SUBID1HERE with the tracking URL supplied by your CPA network. -->
      <a class="cta" href="https://app.trcefy.com/click?pid=2&offer_id=14565&sub2=u828931&sub5=s1SUBID1HERE" target="_blank" rel="noopener noreferrer">ENTER NOW →</a>

      <p class="note">
        This page does not guarantee a gift card. Eligibility, availability, and any reward are subject to the advertiser's official offer terms.
        Do not enter information unless you understand and agree to the offer terms.
      </p>
    </section>

    <div class="footer">
      Independent promotional landing page. Nike is a trademark of its respective owner and this page is not affiliated with or endorsed by Nike unless expressly stated by the advertiser.
    </div>
  </div>
</div>
</body>
</html>
